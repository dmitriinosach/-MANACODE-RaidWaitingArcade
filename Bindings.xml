    <Binding name="HTPARCADE_DOWN" runOnUp="true">
        HTP_ArcadeKey("down", keystate);
    </Binding>
    <Binding name="HTPARCADE_FIRE" runOnUp="true">
        HTP_ArcadeKey("fire", keystate);
